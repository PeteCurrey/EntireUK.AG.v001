# ==============================================================================
# Entire UK — Environment Configuration
# ==============================================================================

# Site Domain
NEXT_PUBLIC_SITE_URL=https://entire-uk.com

# ------------------------------------------------------------------------------
# Supabase & Land Radar (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
# Public Supabase URL
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Key (Safe for browser / public website usage, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Used for internal Land Radar ingestion and spatial analysis pipelines
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Analytics & Logging
# ------------------------------------------------------------------------------
# Optional Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=
